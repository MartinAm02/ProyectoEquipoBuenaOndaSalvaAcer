# Credenciales LWA (Login with Amazon) obtenidas en el self-authorization
# del Solution Provider Portal. NUNCA versionar el .env real.
SPAPI_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxx
SPAPI_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxx
SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxx

# Region / marketplace. Mexico vive en la region NA.
SPAPI_ENDPOINT=https://sellingpartnerapi-na.amazon.com
SPAPI_LWA_ENDPOINT=https://api.amazon.com/auth/o2/token
SPAPI_MARKETPLACE_ID=A1AM78C64UM0Y8

# Rango de fechas por defecto para las pruebas (ISO 8601, UTC).
SPAPI_TEST_DAYS_BACK=7
